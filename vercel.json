{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://api.edubridge-ai.com/api/$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                }
            ]
        }
    ]
}