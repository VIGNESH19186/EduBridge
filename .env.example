# --- Database ---
# Use SQLite for local/demo (default). For production use Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/edubridge
DATABASE_URL=sqlite:///./edubridge.db

# --- Auth ---
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Provider (leave AI_API_KEY empty to run in DEMO MODE) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500
